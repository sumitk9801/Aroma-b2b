generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String          @id @default(uuid())
  name             String
  email            String          @unique
  password         String
  role             String          @default("staff")
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  purchases           Purchase[]         @relation("UserPurchases")
  refreshTokens       RefreshToken[]
  sales               Sale[]             @relation("UserSales")
  shops               Shop[]             @relation("UserShops")
  stockAdjustments    StockMovement[]    @relation("UserStockMovements")
  shopStaff           ShopStaff[]
  productRequests     ProductRequest[]   @relation("UserProductRequests")
  productReviews      ProductRequest[]   @relation("UserProductReviews")
  damageReports       DamagedStock[]     @relation("UserDamageReports")
}

model BlackList {
  id       String   @id @default(uuid())
  token    String   @unique
  expireAt DateTime
}

model Shop {
  id               String          @id @default(uuid())
  shopCode         Int             @unique @default(autoincrement())
  ownerId          String
  shopName         String
  businessType     String?
  address          String?
  phone            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  categories       Category[]
  products         Product[]
  purchases        Purchase[]
  sales            Sale[]
  owner            User              @relation("UserShops", fields: [ownerId], references: [id], onDelete: Cascade)
  stockAdjustments StockMovement[]
  staff            ShopStaff[]
  productRequests  ProductRequest[]
  customers        Customer[]
  suppliers        Supplier[]
  damagedStock     DamagedStock[]
  dailyMetrics     DailyShopMetrics[]
  dailyProductPerf DailyProductPerformance[]
  refunds          Refund[]
}

model ShopStaff {
  id        String   @id @default(uuid())
  shopId    String
  userId    String
  role      String   @default("staff")
  staffId   String?  @unique
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
}

model Category {
  id        String    @id @default(uuid())
  shopId    String
  name      String
  image     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products  Product[]
}

model Product {
  id               String          @id @default(uuid())
  shopId           String
  categoryId       String
  name             String
  description      String?
  skuCode          String          @unique
  barcodes         String?
  image            Json?
  purchasePrice    Float           @default(0.00)
  sellingPrice     Float           @default(0.00)
  currentStock     Float           @default(0.00)
  minimumStock     Float           @default(5.00)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  categoryRef      Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  shop             Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  purchaseItems    PurchaseItem[]
  saleItems        SaleItem[]
  stockAdjustments StockMovement[]
  productRequests  ProductRequest[]
  damagedStock     DamagedStock[]
  dailyPerformance DailyProductPerformance[]
}

// ─────────────────────────────────────────────────────────────────
// Customer — tracks B2B clients for purchase history & analysis
// ─────────────────────────────────────────────────────────────────
model Customer {
  id        String   @id @default(uuid())
  shopId    String
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales     Sale[]

  @@index([shopId])
  @@index([shopId, createdAt])
}

// ─────────────────────────────────────────────────────────────────
// Supplier — tracks vendors for purchase history & spend analysis
// ─────────────────────────────────────────────────────────────────
model Supplier {
  id        String     @id @default(uuid())
  shopId    String
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@index([shopId])
}

// ─────────────────────────────────────────────────────────────────
// DamagedStock — dedicated damage/write-off event log
// ─────────────────────────────────────────────────────────────────
model DamagedStock {
  id          String   @id @default(uuid())
  shopId      String
  productId   String
  quantity    Float
  reason      String?
  valueLost   Float    @default(0.00)
  reportedBy  String
  createdAt   DateTime @default(now())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporter    User     @relation("UserDamageReports", fields: [reportedBy], references: [id])

  @@index([shopId, createdAt])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────
// DailyShopMetrics — nightly precomputed store KPIs (AI-ready)
// ─────────────────────────────────────────────────────────────────
model DailyShopMetrics {
  id               String   @id @default(uuid())
  shopId           String
  date             DateTime
  totalSalesCount  Int      @default(0)
  totalRevenue     Float    @default(0.00)
  costOfGoodsSold  Float    @default(0.00)
  netProfit        Float    @default(0.00)
  grossMargin      Float    @default(0.00)
  totalPurchases   Int      @default(0)
  purchaseExpenses Float    @default(0.00)
  totalDamageValue Float    @default(0.00)
  newCustomers     Int      @default(0)
  createdAt        DateTime @default(now())
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, date])
  @@index([shopId, date])
}

// ─────────────────────────────────────────────────────────────────
// DailyProductPerformance — per-product daily sales (AI forecasting)
// ─────────────────────────────────────────────────────────────────
model DailyProductPerformance {
  id           String   @id @default(uuid())
  productId    String
  shopId       String
  date         DateTime
  quantitySold Float    @default(0.00)
  revenue      Float    @default(0.00)
  unitsSold    Int      @default(0)
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([productId, date])
  @@index([shopId, date])
}

model Purchase {
  id           String         @id @default(uuid())
  shopId       String
  supplierId   String?
  supplierName String?
  totalAmount  Float          @default(0.00)
  createdBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  creator      User           @relation("UserPurchases", fields: [createdBy], references: [id], onDelete: Cascade)
  shop         Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  items        PurchaseItem[]

  @@index([shopId, createdAt])
}

model PurchaseItem {
  id            String   @id @default(uuid())
  purchaseId    String
  productId     String
  quantity      Float
  purchasePrice Float
  subtotal      Float
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model Sale {
  id            String     @id @default(uuid())
  shopId        String
  customerId    String?
  customerName  String?
  totalAmount   Float      @default(0.00)
  paymentMethod String?
  createdBy     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  creator       User       @relation("UserSales", fields: [createdBy], references: [id], onDelete: Cascade)
  shop          Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer      Customer?  @relation(fields: [customerId], references: [id])
  items         SaleItem[]

  @@index([shopId, createdAt])
  @@index([createdBy, createdAt])
  @@index([customerId])
}

model SaleItem {
  id           String  @id @default(uuid())
  saleId       String
  productId    String
  quantity     Float
  sellingPrice Float
  subtotal     Float
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale         Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id            String   @id @default(uuid())
  shopId        String
  productId     String
  type          String   // addition | reduction | damage | return | adjustment
  quantity      Float
  previousStock Float
  newStock      Float
  referenceType String?
  referenceId   String?
  note          String?
  createdBy     String
  createdAt     DateTime @default(now())
  creator       User     @relation("UserStockMovements", fields: [createdBy], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([productId, createdAt])
  @@index([type, shopId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProductRequest {
  id             String    @id @default(uuid())
  shopId         String
  requestedBy    String
  name           String
  description    String?
  barcodes       String?
  suggestedPrice Float?
  categoryHint   String?
  quantity       Float?
  supplierHint   String?
  status         String    @default("PENDING")
  reviewNote     String?
  reviewedBy     String?
  reviewedAt     DateTime?
  productId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  shop           Shop      @relation(fields: [shopId],      references: [id], onDelete: Cascade)
  requester      User      @relation("UserProductRequests", fields: [requestedBy], references: [id], onDelete: Cascade)
  reviewer       User?     @relation("UserProductReviews",  fields: [reviewedBy],  references: [id])
  product        Product?  @relation(fields: [productId],   references: [id])
}

model Refund {
  id          String   @id @default(uuid())
  refundCode  Int      @unique @default(autoincrement())
  shopId      String
  cashierName String
  amount      Float
  items       String
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

