generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String          @id @default(uuid())
  name             String
  email            String          @unique
  password         String
  role             String          @default("staff")
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  purchases           Purchase[]         @relation("UserPurchases")
  refreshTokens       RefreshToken[]
  sales               Sale[]             @relation("UserSales")
  shops               Shop[]             @relation("UserShops")
  stockAdjustments    StockMovement[]    @relation("UserStockMovements")
  shopStaff           ShopStaff[]
  productRequests     ProductRequest[]   @relation("UserProductRequests")
  productReviews      ProductRequest[]   @relation("UserProductReviews")
}

model BlackList {
  id       String   @id @default(uuid())
  token    String   @unique
  expireAt DateTime
}

model Shop {
  id               String          @id @default(uuid())
  shopCode         Int             @unique @default(autoincrement())
  ownerId          String
  shopName         String
  businessType     String?
  address          String?
  phone            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  categories       Category[]
  products         Product[]
  purchases        Purchase[]
  sales            Sale[]
  owner            User              @relation("UserShops", fields: [ownerId], references: [id], onDelete: Cascade)
  stockAdjustments StockMovement[]
  staff            ShopStaff[]
  productRequests  ProductRequest[]
}

model ShopStaff {
  id        String   @id @default(uuid())
  shopId    String
  userId    String
  role      String   @default("staff")
  staffId   String?  @unique
  createdAt DateTime @default(now())
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
}

model Category {
  id        String    @id @default(uuid())
  shopId    String
  name      String
  image     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products  Product[]
}

model Product {
  id               String          @id @default(uuid())
  shopId           String
  categoryId       String
  name             String
  description      String?
  skuCode          String          @unique
  barcodes         String?
  image            Json?
  purchasePrice    Float           @default(0.00)
  sellingPrice     Float           @default(0.00)
  currentStock     Float           @default(0.00)
  minimumStock     Float           @default(5.00)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  categoryRef      Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  shop             Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  purchaseItems    PurchaseItem[]
  saleItems        SaleItem[]
  stockAdjustments StockMovement[]
  productRequests  ProductRequest[]
}

model Purchase {
  id           String         @id @default(uuid())
  shopId       String
  supplierName String?
  totalAmount  Float          @default(0.00)
  createdBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  creator      User           @relation("UserPurchases", fields: [createdBy], references: [id], onDelete: Cascade)
  shop         Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items        PurchaseItem[]
}

model PurchaseItem {
  id            String   @id @default(uuid())
  purchaseId    String
  productId     String
  quantity      Float
  purchasePrice Float
  subtotal      Float
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model Sale {
  id            String     @id @default(uuid())
  shopId        String
  customerName  String?
  totalAmount   Float      @default(0.00)
  paymentMethod String?
  createdBy     String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  creator       User       @relation("UserSales", fields: [createdBy], references: [id], onDelete: Cascade)
  shop          Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items         SaleItem[]
}

model SaleItem {
  id           String  @id @default(uuid())
  saleId       String
  productId    String
  quantity     Float
  sellingPrice Float
  subtotal     Float
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale         Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id            String   @id @default(uuid())
  shopId        String
  productId     String
  type          String
  quantity      Float
  previousStock Float
  newStock      Float
  referenceType String?
  referenceId   String?
  note          String?
  createdBy     String
  createdAt     DateTime @default(now())
  creator       User     @relation("UserStockMovements", fields: [createdBy], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProductRequest {
  id             String    @id @default(uuid())
  shopId         String
  requestedBy    String
  name           String
  description    String?
  barcodes       String?
  suggestedPrice Float?
  categoryHint   String?
  quantity       Float?
  supplierHint   String?
  status         String    @default("PENDING")
  reviewNote     String?
  reviewedBy     String?
  reviewedAt     DateTime?
  productId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  shop           Shop      @relation(fields: [shopId],      references: [id], onDelete: Cascade)
  requester      User      @relation("UserProductRequests", fields: [requestedBy], references: [id], onDelete: Cascade)
  reviewer       User?     @relation("UserProductReviews",  fields: [reviewedBy],  references: [id])
  product        Product?  @relation(fields: [productId],   references: [id])
}
